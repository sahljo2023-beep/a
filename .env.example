# ============================================================
# نظام إدارة دوام الفنادق — متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل
# ============================================================

# ----- قاعدة البيانات -----
POSTGRES_DB=hotel_attendance
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ----- اتصال Prisma (يُستخدم في التطبيق والـ migrations) -----
DATABASE_URL="postgresql://hotel_admin:CHANGE_ME_STRONG_PASSWORD_HERE@localhost:5432/hotel_attendance"

# ----- مستخدم Viewer (قراءة فقط) -----
VIEWER_DB_USER=viewer_role
VIEWER_DB_PASSWORD=CHANGE_ME_VIEWER_PASSWORD_HERE
VIEWER_DATABASE_URL="postgresql://viewer_role:CHANGE_ME_VIEWER_PASSWORD_HERE@localhost:5432/hotel_attendance"

# ----- الجلسات والأمان -----
# يجب أن يكون عشوائياً وطويلاً (على الأقل 32 حرف)
# لتوليد قيمة: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTES_HEX

# لـ Next.js Auth (إن استُخدم)
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES_HEX
NEXTAUTH_URL=http://localhost:3000

# ----- بيئة التشغيل -----
NODE_ENV=development
TZ=Asia/Amman

# ----- Rate Limiting -----
# عدد المحاولات المسموحة لتسجيل الدخول قبل القفل المؤقت
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# عدد محاولات الـ PIN المسموحة قبل القفل
PIN_RATE_LIMIT_MAX=5
PIN_RATE_LIMIT_WINDOW_MS=300000
